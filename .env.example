# Postgres connection. Get from Neon (https://console.neon.tech)
# IMPORTANT: use the prefix postgresql+psycopg:// not postgresql://
DATABASE_URL=postgresql+psycopg://user:password@your-neon-host.aws.neon.tech/neondb?sslmode=require

# Separate database for the test suite. Tests run migrations against
# this DB and truncate tables between tests. Never point at production.
TEST_DATABASE_URL=postgresql+psycopg://user:password@your-neon-host.aws.neon.tech/neondb_test?sslmode=require

# API bearer token. Clients send `Authorization: Bearer <this>`.
API_KEY=sk_test_local_dev_only_change_for_production

# Run mode. True only when pointing at a production database.
LIVEMODE=false
